# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Provider Configuration
# Set to 'remote' to use a real AI endpoint, otherwise it defaults to 'demo'
VITE_AI_PROVIDER=demo

# Required if VITE_AI_PROVIDER=remote
VITE_POTHOLE_AI_ENDPOINT=https://your-ai-proxy-endpoint.com/api/analyze
VITE_POTHOLE_AI_PUBLIC_KEY=your_public_api_key
